generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Domain Constraints)
// ==========================================

enum RoomStatus {
  CREATED
  ACTIVE
  ENDED
}

enum LeaveReason {
  INTENTIONAL
  DISCONNECTED
  KICKED
}

// ==========================================
// MODELS (Entities)
// ==========================================

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  apiKey    String   @unique @map("api_key") @db.VarChar(100)
  apiSecret String   @map("api_secret") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi (1 Tenant memiliki banyak Room)
  rooms Room[]

  @@index([apiKey]) // Optimasi untuk pencarian middleware autentikasi
  @@map("tenants")
}

model Room {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  logicalName     String     @map("logical_name") @db.VarChar(255)
  livekitRoomName String     @unique @map("livekit_room_name") @db.VarChar(255)
  status          RoomStatus @default(CREATED)
  createdAt       DateTime   @default(now()) @map("created_at")
  endedAt         DateTime?  @map("ended_at")

  // Foreign Key constraint
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relasi (1 Room memiliki banyak Participant)
  participants Participant[]

  @@index([livekitRoomName]) // Sangat krusial: LiveKit Webhook akan mencari room berdasarkan field ini
  @@map("rooms")
}

model Participant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String       @map("room_id") @db.Uuid
  identity    String       @db.VarChar(255) // ID dari sisi Aplikasi Utama (Tenant)
  name        String       @db.VarChar(255)
  joinedAt    DateTime?    @map("joined_at")
  leftAt      DateTime?    @map("left_at")
  leaveReason LeaveReason? @map("leave_reason")

  // Foreign Key constraint
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, identity]) // Optimasi pencarian saat update status partisipan
  @@map("participants")
}
